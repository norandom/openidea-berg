// Berg: editor colour scheme (syntax, editor surfaces, console ANSI colours),
// the counterpart of an IntelliJ .icls file, kept separate from the IDE theme
// in berg.theme.json. Ported 1:1 from the Berg VS Code theme (jx22) via the
// Zed port (zed_berg): black editor, amber text, red comments, green types.
{
  "name": "Berg",
  "tokens": {
    // Syntax
    "--syn-keyword": "#6d96d0",
    // Berg's own string/number/variable values (#754612, #521c51, #0253a6)
    // are near-invisible on the black editor and the preview's code blocks;
    // use the brighter pre-override VS Code defaults instead (as the built-in
    // dark themes do).
    "--syn-string": "#ce9178",
    "--syn-type": "#60c487",
    "--syn-function": "#fee334",
    "--syn-function-call": "#fee334",
    "--syn-comment": "#d54135",
    "--syn-comment-style": "normal",
    "--syn-doc-comment": "#d54135",
    "--syn-docstring": "#d54135",
    "--syn-annotation": "#f49f31",
    "--syn-decorator": "#f49f31",
    "--syn-number": "#b5cea8",
    "--syn-punct": "#d4d4d4",
    "--syn-variable": "#9cdcfe",
    "--syn-param": "#9cdcfe",
    "--syn-property": "#f49f31",
    "--syn-constant": "#51b6c4",
    "--syn-builtin": "#51b6c4",
    "--syn-self": "#9cdcfe",
    "--syn-keyword-arg": "#6d96d0",
    "--syn-predefined": "#fee334",
    "--syn-escape": "#d7ba7d",
    "--syn-regexp": "#d16969",
    "--syn-tag": "#abd3e0",
    "--syn-attribute": "#f49f31",
    "--syn-todo": "#6796e6",
    "--syn-link": "#6d96d0",
    "--syn-markup-heading": "#5dc453",
    "--syn-markup-code": "#8c6eaf",
    "--syn-invalid": "#f44747",
    "--syn-inline-value": "#acacae",
    "--syn-rainbow-1": "#4dc7f9",
    "--syn-rainbow-2": "#fee334",
    "--syn-rainbow-3": "#5dc453",
    "--syn-rainbow-4": "#8c6eaf",
    "--syn-rainbow-5": "#f49f31",
    "--syn-bracket-1": "#f49f31",
    "--syn-bracket-2": "#8c6eaf",
    "--syn-bracket-3": "#4dc7f9",

    // Editor
    "--fg-editor": "#f49f31",
    "--caret": "#4dc7f9",
    "--fg-line-number": "#9e9e9e",
    "--fg-line-number-current": "#d7d7d7",
    "--border-gutter": "#000000",
    "--border-indent-guide": "#a2b4bd",
    "--border-indent-guide-active": "#707070",
    "--border-right-margin": "#5a5a5a",
    "--bg-editor": "#000000",
    "--bg-editor-gutter": "#000000",
    "--bg-editor-selection": "#353f40",
    "--bg-editor-selection-inactive": "#464646",
    "--bg-text-search-result": "#223d58",
    "--bg-text-search-result-current": "#68339c",
    "--bg-matched-brace": "#d54135",
    "--matched-brace-weight": "700",
    "--bg-matched-tag": "#d54135",
    "--bg-fold-placeholder": "#353f404d",
    "--fg-fold-placeholder": "#d7d7d7",
    "--fg-fold-marker": "#f49f31",
    "--fg-whitespace": "#64666780",
    "--fg-unused": "#646667",
    "--bg-identifier-under-caret": "#464646",
    "--bg-identifier-under-caret-write": "#242224",
    "--fg-inlay": "#acacae",
    "--bg-inlay": "#202020",
    "--wave-error": "#f44747",
    "--wave-warning": "#cd9731",
    "--editor-error-decoration": "underline wavy #f44747",
    "--editor-warning-decoration": "underline wavy #cd9731",
    "--editor-warning-background": "transparent",
    "--bg-breakpoint-line": "#d5413520",
    "--fg-completion-match": "#5dc453",
    "--bg-editor-inline": "#202020",
    "--bg-editor-banner": "#202020",
    "--fg-weak-warning": "#acacae",
    "--fg-bulb": "#5dc453",

    // ANSI palette
    "--ansi-black": "#202020",
    "--ansi-red": "#d54135",
    "--ansi-green": "#5dc453",
    "--ansi-yellow": "#f49f31",
    "--ansi-blue": "#6d96d0",
    "--ansi-magenta": "#8c6eaf",
    "--ansi-cyan": "#4dc7f9",
    "--ansi-white": "#d7d7d7",
    "--ansi-bright-black": "#646667",
    "--ansi-bright-red": "#f44747",
    "--ansi-bright-green": "#60c487",
    "--ansi-bright-yellow": "#fee334",
    "--ansi-bright-blue": "#6796e6",
    "--ansi-bright-magenta": "#da9bff",
    "--ansi-bright-cyan": "#abd3e0",
    "--ansi-bright-white": "#ffffff",

    // Terminal ANSI palette
    "--terminal-ansi-black": "#202020",
    "--terminal-ansi-red": "#d54135",
    "--terminal-ansi-green": "#5dc453",
    "--terminal-ansi-yellow": "#f49f31",
    "--terminal-ansi-blue": "#6d96d0",
    "--terminal-ansi-magenta": "#8c6eaf",
    "--terminal-ansi-cyan": "#4dc7f9",
    "--terminal-ansi-white": "#d7d7d7",
    "--terminal-ansi-bright-black": "#646667",
    "--terminal-ansi-bright-red": "#f44747",
    "--terminal-ansi-bright-green": "#60c487",
    "--terminal-ansi-bright-yellow": "#fee334",
    "--terminal-ansi-bright-blue": "#6796e6",
    "--terminal-ansi-bright-magenta": "#da9bff",
    "--terminal-ansi-bright-cyan": "#abd3e0",
    "--terminal-ansi-bright-white": "#ffffff"
  }
}
